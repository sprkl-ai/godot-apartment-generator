class_name Loot
extends RefCounted

enum Type {
	WEAPON, ARMOR, HEAL, FRIES, HAT, CURTAIN, SLUT_ARMOR, BIRCH_PANTS, ZEUS_BOOTS,
	KEY_FRAGMENT, MAGNETIC_KEY,
	SAFE_CODE, CROWBAR, REPAIR_TOOLS, SPIT_PIPE,
	YOYO, SCRAP,
	FOG_SOUL, PLANT_FERN, PLANT_FICUS, PLANT_CACTUS, PLANT_ALOE, PLANT_IVY,
	LIFT_CARPET, LIFT_LAMP, LIGHT_BULB, LIFT_PAINTING, LIFT_CLOCK, LIFT_WORKBENCH,
	CLOTHING_ORB, WEAPON_ORB,
	COLLECTOR_DISC, SOUL_COLLECTOR, SANITY_TABLETS,
}

static func is_plant(type: int) -> bool:
	return type in [Type.PLANT_FERN, Type.PLANT_FICUS, Type.PLANT_CACTUS, Type.PLANT_ALOE, Type.PLANT_IVY]
